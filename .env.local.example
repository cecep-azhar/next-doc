# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT
# =============================================================================
# File ini untuk development di komputer local Anda
# Copy file ini dan sesuaikan dengan konfigurasi MySQL local Anda

# =============================================================================
# DATABASE CONFIGURATION - MySQL Local
# =============================================================================
DATABASE_MODE=mysql
# Sesuaikan dengan konfigurasi MySQL local Anda:
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://root:@localhost:3306/next_doc"

# Atau jika MySQL Anda menggunakan password:
# DATABASE_URL="mysql://root:your_password@localhost:3306/next_doc"

# =============================================================================
# NEXTAUTH.JS V5 CONFIGURATION
# =============================================================================
# Generate secret dengan: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# OAuth Providers (optional - isi jika ingin testing OAuth)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# STRIPE BILLING - Test Keys
# =============================================================================
# Gunakan test keys dari Stripe Dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs (create in Stripe Dashboard - Test Mode)
STRIPE_PRICE_ID_FREE=""
STRIPE_PRICE_ID_PRO="price_xxx"
STRIPE_PRICE_ID_TEAM="price_xxx"

# =============================================================================
# TYPESENSE SEARCH (Local)
# =============================================================================
# Install Typesense local atau gunakan Docker:
# docker run -p 8108:8108 -v/tmp/data:/data typesense/typesense:26.0 --data-dir /data --api-key=xyz
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="xyz"
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_API_KEY="xyz"

# =============================================================================
# EMAIL (RESEND) - Optional untuk development
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM="DocuVerse <noreply@localhost>"

# =============================================================================
# UPLOADTHING (FILE UPLOADS) - Optional
# =============================================================================
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""

# =============================================================================
# RATE LIMITING (UPSTASH REDIS) - Optional untuk development
# =============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =============================================================================
# APP CONFIGURATION - Local
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DocuVerse SaaS"
NEXT_PUBLIC_SUPPORT_EMAIL="support@localhost"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# =============================================================================
# SUPER ADMIN - Default untuk development
# =============================================================================
SUPERADMIN_EMAIL="admin@localhost"
SUPERADMIN_PASSWORD="admin123"
SUPERADMIN_NAME="Super Admin"
