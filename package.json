{
  "name": "docuverse-saas",
  "version": "1.0.0",
  "description": "The most beautiful, fastest, and developer-friendly multi-tenant SaaS documentation platform",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node scripts/setup-wizard.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-db.ts",
    "postinstall": "prisma generate",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhook/stripe",
    "validate:env": "tsx scripts/validate-env.ts",
    "deploy:check": "npm run validate:env && npm run lint && npm run build"
  },
  "dependencies": {
