# =============================================================================
# PRODUCTION ENVIRONMENT
# =============================================================================
# File ini untuk deployment ke production (Vercel, VPS, dll)
# JANGAN commit file ini ke Git! Tambahkan ke .gitignore

# =============================================================================
# DATABASE CONFIGURATION - MySQL Production
# =============================================================================
DATABASE_MODE=mysql
# Gunakan connection string dari hosting MySQL Anda
# Contoh untuk berbagai provider:

# Railway MySQL:
# DATABASE_URL="mysql://root:password@containers-us-west-xxx.railway.app:3306/railway"

# PlanetScale (MySQL-compatible):
# DATABASE_MODE=planetscale
# DATABASE_URL="mysql://user:password@aws.connect.psdb.cloud/database?sslaccept=strict"

# Digital Ocean MySQL:
# DATABASE_URL="mysql://user:password@db-mysql-sgp1-xxxxx-do-user-xxxxx-0.db.ondigitalocean.com:25060/defaultdb?ssl-mode=REQUIRED"

# VPS / CloudPanel / cPanel:
# DATABASE_URL="mysql://username:password@your-server.com:3306/database_name"

DATABASE_URL="mysql://your_user:your_password@your_host:3306/your_database"

# Optional: Prisma Accelerate untuk caching & connection pooling
# PRISMA_ACCELERATE_URL="prisma://accelerate.prisma-data.net/?api_key=your-key"

# =============================================================================
# NEXTAUTH.JS V5 CONFIGURATION
# =============================================================================
# IMPORTANT: Generate strong secret dengan: openssl rand -base64 32
AUTH_SECRET="GENERATE_NEW_SECRET_WITH_OPENSSL_RAND_BASE64_32"
AUTH_URL="https://yourdomain.com"
AUTH_TRUST_HOST=true

# OAuth Providers (Production credentials)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# =============================================================================
# STRIPE BILLING - Live Keys
# =============================================================================
# GUNAKAN LIVE KEYS dari Stripe Dashboard!
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs (create in Stripe Dashboard - Live Mode)
STRIPE_PRICE_ID_FREE=""
STRIPE_PRICE_ID_PRO="price_xxx"
STRIPE_PRICE_ID_TEAM="price_xxx"

# =============================================================================
# TYPESENSE SEARCH (Production - Cloud atau VPS)
# =============================================================================
# Typesense Cloud: https://cloud.typesense.org
# Atau self-hosted di VPS
TYPESENSE_HOST="xxx.a1.typesense.net"
TYPESENSE_PORT="443"
TYPESENSE_PROTOCOL="https"
TYPESENSE_API_KEY="your_admin_api_key"
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_API_KEY="your_search_only_api_key"

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
# Dapatkan API key dari: https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="DocuVerse <noreply@yourdomain.com>"

# =============================================================================
# UPLOADTHING (FILE UPLOADS)
# =============================================================================
# Dapatkan credentials dari: https://uploadthing.com
UPLOADTHING_SECRET="sk_live_xxxxxxxxxxxx"
UPLOADTHING_APP_ID="your_app_id"

# =============================================================================
# RATE LIMITING (UPSTASH REDIS)
# =============================================================================
# Dapatkan credentials dari: https://upstash.com
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_token"

# =============================================================================
# APP CONFIGURATION - Production
# =============================================================================
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="DocuVerse SaaS"
NEXT_PUBLIC_SUPPORT_EMAIL="support@yourdomain.com"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# =============================================================================
# SUPER ADMIN - Production
# =============================================================================
# GANTI dengan email dan password yang aman!
SUPERADMIN_EMAIL="admin@yourdomain.com"
SUPERADMIN_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD"
SUPERADMIN_NAME="Super Admin"

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Jangan pernah commit file ini ke Git
# 2. Generate AUTH_SECRET yang kuat dengan: openssl rand -base64 32
# 3. Gunakan password yang kuat untuk SUPERADMIN_PASSWORD
# 4. Aktifkan SSL/HTTPS untuk production
# 5. Backup database secara regular
# 6. Monitor error logs dan metrics
