# =============================================================================
# DATABASE CONFIGURATION — CHOOSE ONE MODE (uncomment the section you need)
# =============================================================================

# -----------------------------------------------------------------------------
# MODE 1: DEVELOPMENT (Local SQLite) — DEFAULT
# -----------------------------------------------------------------------------
# Use this for local development. Creates ./prisma/dev.db automatically.
# No external database needed. Perfect for testing.
DATABASE_MODE=sqlite
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# MODE 2: TURSO (Edge SQLite — Recommended for Production)
# -----------------------------------------------------------------------------
# Create account at https://turso.tech
# Run: turso db create docuverse-prod
# Run: turso db tokens create docuverse-prod
# DATABASE_MODE=turso
# DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token-here"

# -----------------------------------------------------------------------------
# MODE 3: MySQL (Self-Hosted — CloudPanel / Railway / Local)
# -----------------------------------------------------------------------------
# Use this if you host MySQL on CloudPanel, Railway, or local server
# DATABASE_MODE=mysql
# DATABASE_URL="mysql://user:password@localhost:3306/docuverse"

# -----------------------------------------------------------------------------
# MODE 4: PlanetScale / Neon / Railway (Cloud Production)
# -----------------------------------------------------------------------------
# PlanetScale: mysql://user:password@aws.connect.psdb.cloud/docuverse?sslaccept=strict
# Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/docuverse
# DATABASE_MODE=planetscale
# DATABASE_URL="mysql://your-planetscale-connection-string"
# PRISMA_ACCELERATE_URL="prisma://accelerate.prisma-data.net/?api_key=your-key"

# =============================================================================
# NEXTAUTH.JS V5 CONFIGURATION
# =============================================================================
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# OAuth Providers (optional — add if needed)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# STRIPE BILLING CONFIGURATION
# =============================================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_ID_FREE=""
STRIPE_PRICE_ID_PRO="price_xxx"
STRIPE_PRICE_ID_TEAM="price_xxx"

# =============================================================================
# TYPESENSE SEARCH (Self-Hosted or Cloud)
# =============================================================================
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"
TYPESENSE_API_KEY="xyz"
NEXT_PUBLIC_TYPESENSE_SEARCH_ONLY_API_KEY="xyz"

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
RESEND_API_KEY="re_xxx"
EMAIL_FROM="DocuVerse <noreply@docuverse.id>"

# =============================================================================
# UPLOADTHING (FILE UPLOADS)
# =============================================================================
UPLOADTHING_SECRET="sk_live_xxx"
UPLOADTHING_APP_ID="xxx"

# =============================================================================
# RATE LIMITING (UPSTASH REDIS)
# =============================================================================
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# =============================================================================
# APP CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DocuVerse SaaS"
NEXT_PUBLIC_SUPPORT_EMAIL="support@docuverse.id"

# Default locale (en or id)
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# =============================================================================
# SUPER ADMIN (First User — Change After Setup)
# =============================================================================
SUPERADMIN_EMAIL="admin@docuverse.id"
SUPERADMIN_PASSWORD="ChangeMeInProduction123!"
SUPERADMIN_NAME="Super Admin"
